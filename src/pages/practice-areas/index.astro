---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const practiceAreas = await getCollection('practiceAreas', ({ data }) => !data.draft);
---

<BaseLayout
  title="Practice Areas — BSV Law"
  description="BSV Law's practice areas — Mergers & Acquisitions, Intellectual Property & Technology Transactions, Tax."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-[color:var(--color-text)]">Practice Areas</h1>
    {practiceAreas.length === 0 ? (
      <p class="mt-6 text-base leading-relaxed text-[color:var(--color-text-muted)]">
        Practice area pages arrive in Phase 4 of the build.
      </p>
    ) : (
      <ul class="mt-6 space-y-3">
        {practiceAreas.map((entry) => (
          <li>
            <a
              href={`/practice-areas/${entry.data.slug}`}
              class="text-[color:var(--color-text)] underline"
            >
              {entry.data.name}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
