---
/* Homepage (/) — the public composition of the locked Phase 2 component
   library. Order (D-01, amended by D-35 to surface Chambers recognition high):
   Hero -> ApproachBand -> ChambersStrip -> PracticeAreaCard x3 -> DealsGrid
   -> AttorneyCard x5 -> TestimonialQuote -> CtaBlock.
   Content (hero copy, practice teasers, attorneys, deals, testimonial) is the
   FIRM_BRIEF placeholder set reused verbatim from the /design-system gallery
   (D-03). All named deals are cleared in CLIENT_DISCLOSURE_CLEARANCE.md (D-04).
   Public route — no noindex. Footer disclaimer + LegalService JSON-LD are
   injected by BaseLayout. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ApproachBand from '../components/sections/ApproachBand.astro';
import PracticeAreaCard from '../components/sections/PracticeAreaCard.astro';
import AttorneyCard from '../components/sections/AttorneyCard.astro';
import DealsGrid from '../components/sections/DealsGrid.astro';
import TestimonialQuote from '../components/sections/TestimonialQuote.astro';
import ChambersStrip from '../components/sections/ChambersStrip.astro';
import CtaBlock from '../components/sections/CtaBlock.astro';

// Attorney headshots (real photos from the firm's existing site) — processed by <Image>.
import photoBelcher from '../assets/headshots/belcher.jpg';
import photoSmolen from '../assets/headshots/smolen.jpg';
import photoVanLoo from '../assets/headshots/vanloo.jpg';
import photoZhang from '../assets/headshots/zhang.jpg';
import photoJiang from '../assets/headshots/jiang.jpg';

// FIRM_BRIEF placeholder data (reused from the gallery — D-03).
const attorneys = [
  {
    name: 'Aaron Belcher',
    role: 'Partner',
    focus: 'Corporate & M&A — technology and life sciences',
    photo: photoBelcher,
    alt: 'Aaron Belcher, Partner',
  },
  {
    name: 'Stuart Smolen',
    role: 'Partner',
    focus: 'IP & technology transactions; USPTO-registered',
    photo: photoSmolen,
    alt: 'Stuart Smolen, Partner',
  },
  {
    name: 'Jon Van Loo',
    role: 'Partner',
    focus: 'M&A, international, and crypto tax',
    photo: photoVanLoo,
    alt: 'Jon Van Loo, Partner',
  },
  {
    name: 'Iris Zhang',
    role: 'Associate',
    focus: 'Securities, regulatory & compliance',
    photo: photoZhang,
    alt: 'Iris Zhang, Associate',
  },
  {
    name: 'Susan (Kezhen) Jiang',
    role: 'Associate',
    focus: 'Corporate & commercial guidance for technology companies — China & Greater Pacific',
    photo: photoJiang,
    alt: 'Susan (Kezhen) Jiang, Associate',
  },
];

const deals = [
  { title: 'Athelas / Commure', amount: '$6B merger', context: 'Cross-border technology M&A.' },
  { title: 'Mode Analytics', amount: '$200M sale', context: 'Venture-backed software exit.' },
  {
    title: 'Illumina',
    context: "Defense against Roche's $6.4B hostile bid.",
  },
  {
    title: 'Representative parties',
    context: 'Adobe · Oracle · PayPal · Dell · eBay · Coinbase',
  },
];
---

<BaseLayout
  title="Belcher, Smolen & Van Loo LLP"
  description="A boutique California law firm focused on Mergers & Acquisitions, Intellectual Property & Technology Transactions, and Tax for the technology, life sciences, cryptocurrency, FinTech, and AI industries."
>
  <!-- 1. Hero -->
  <Hero
    eyebrow="Belcher, Smolen & Van Loo LLP"
    headline="Team work to get good results."
    subhead="A boutique M&A, technology, and tax practice for the companies building what's next — partner-led, fast-moving, and built around your transaction."
    ctaLabel="Start a conversation"
    ctaHref="/contact"
    secondaryLabel="See our work"
    secondaryHref="/practice-areas"
  />

  <!-- 2. ApproachBand (the StoryBrand guide-with-a-plan beat) -->
  <ApproachBand />

  <!-- 2.5 ChambersStrip — recognition surfaced high (D-35), right after the Approach band -->
  <ChambersStrip />

  <!-- 3. PracticeAreaCard (x3) -->
  <section class="bg-bg py-section">
    <div class="mx-auto max-w-6xl px-gutter">
      <h2 class="mb-8 text-h2 font-bold text-text">Practice areas</h2>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        <PracticeAreaCard
          icon="practice-mergers-acquisitions"
          title="Mergers & Acquisitions"
          blurb="Domestic and cross-border M&A for acquirers, PE firms, and venture-backed targets — from $6B mergers to founder exits."
          href="/practice-areas/mergers-acquisitions"
        />
        <PracticeAreaCard
          icon="practice-ip-tech"
          title="Intellectual Property & Technology Transactions"
          blurb="Patent strategy, licensing, open-source and data-security counsel for companies whose IP is the deal."
          href="/practice-areas/intellectual-property-technology-transactions"
        />
        <PracticeAreaCard
          icon="practice-tax"
          title="Tax"
          blurb="M&A tax, cross-border structuring, and crypto/blockchain taxation — the structuring that makes the deal work."
          href="/practice-areas/tax"
        />
      </div>
    </div>
  </section>

  <!-- 4. DealsGrid (Representative work) — BEFORE the team + testimonial per D-01 -->
  <DealsGrid heading="Representative work" deals={deals} />

  <!-- 5. AttorneyCard (x5) — no href in Phase 3 (detail routes land in Phase 4) -->
  <section class="bg-bg py-section">
    <div class="mx-auto max-w-6xl px-gutter">
      <h2 class="mb-8 text-h2 font-bold text-text">The team</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          attorneys.map((a) => (
            <AttorneyCard
              name={a.name}
              role={a.role}
              focus={a.focus}
              photo={a.photo}
              alt={a.alt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. TestimonialQuote -->
  <TestimonialQuote
    quote="BSV was my rock throughout the $6 billion merger between Athelas and Commure."
    attribution="Daniel Brian"
    attributionDetail="GC, Commure, Inc."
  />

  <!-- 7. CtaBlock -->
  <CtaBlock
    heading="Have a transaction in motion?"
    body="Tell us about your deal. We'll tell you how we'd approach it — and what it'll cost."
    ctaLabel="Start a conversation"
    ctaHref="/contact"
  />
</BaseLayout>
