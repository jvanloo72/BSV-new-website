---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — BSV Law"
  description="The page you requested could not be found."
>
  <section class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="text-3xl font-semibold tracking-tight text-[color:var(--color-text)]">Page not found</h1>
    <p class="mt-6 text-base leading-relaxed text-[color:var(--color-text-muted)]">
      We couldn't find the page you were looking for.
      <a href="/" class="underline">Return to the homepage</a>.
    </p>
  </section>
</BaseLayout>
