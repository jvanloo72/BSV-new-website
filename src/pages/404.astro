---
/* Branded 404 (PAGES-07) — replaces the generic Vercel page. Warm, on-tone
   copy and TWO clear paths back: home (primary) and contact (secondary).
   Renders FIXED static content only — no stack traces, internal paths, or env
   values (T-03-07). Normal route — NOT noindex. Token-only. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page not found — Belcher, Smolen & Van Loo LLP"
  description="The page you requested could not be found."
>
  <section class="mx-auto max-w-3xl px-gutter py-section">
    <p class="text-small font-medium uppercase tracking-wide text-text-muted">404</p>
    <h1 class="mt-2 text-h1 font-bold text-text">This page took a wrong turn.</h1>
    <p class="mt-4 text-body-lg text-text-muted">
      The page you were looking for isn&rsquo;t here — it may have moved, or the
      link may be out of date. Let&rsquo;s get you back on track.
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button variant="primary" href="/" label="Back to home" />
      <Button variant="secondary" href="/contact" label="Get in touch" />
    </div>
  </section>
</BaseLayout>
