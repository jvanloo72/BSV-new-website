---
/* ChambersStrip — prominent recognition strip (Phase 3 LEGAL-07).
   D-35: placed high on the homepage (right after the BSV Approach band) so the
   recognition is clearly visible near the top. D-34: shows the real Chambers
   USA Spotlight 2026 badge (the firm's own asset from the prior site).
   Uses a plain <img> served raw from /public/chambers-2026.png (NOT the
   astro:assets optimizer) for maximum reliability — the optimizer pipeline
   was intermittently failing in this environment. Non-linked. Static, no
   props. data-component marker for tests. */
---

<section data-component="ChambersStrip" class="bg-bg py-section">
  <div class="mx-auto max-w-6xl px-gutter">
    <div class="flex justify-center">
      <img
        src="/chambers-2026.png"
        alt="Chambers USA Spotlight 2026"
        width="240"
        height="208"
        loading="eager"
        decoding="async"
        class="h-auto w-60"
      />
    </div>
  </div>
</section>
