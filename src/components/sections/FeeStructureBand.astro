---
/* FeeStructureBand — plain-English billing transparency (LEGAL-08). A banded
   floating surface (bg-bg-elevated, rounded-card, soft warm shadow) with a small
   accent leading marker, a short heading, and fee copy. NO published rates
   (rates are discussed one-on-one, never on the site). Static. Token-only;
   data-component marker for the gallery test. */
interface Props {
  heading: string;
  body: string;
  note?: string;
}

const { heading, body, note } = Astro.props;
---

<section data-component="FeeStructureBand" class="bg-bg py-section">
  <div class="mx-auto max-w-6xl px-gutter">
    <div
      class="rounded-card border border-border bg-bg-elevated p-8 shadow-card md:flex md:items-start md:gap-10 md:p-10"
    >
      <div class="md:w-1/3">
        <span class="block h-1 w-10 rounded-full bg-accent" aria-hidden="true"></span>
        <h2 class="mt-4 text-h3 font-bold text-text">{heading}</h2>
      </div>
      <div class="mt-4 md:mt-0 md:w-2/3">
        <p class="text-body-lg text-text">{body}</p>
        {note && <p class="mt-3 text-small text-text-muted">{note}</p>}
      </div>
    </div>
  </div>
</section>
