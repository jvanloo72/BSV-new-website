---
/* Eyebrow primitive — uppercase kicker label placed above section headings
   (UI-SPEC §"UI primitives"). Token-only — muted color, uppercase. D-40: the
   default size is text-xl so every site-wide eyebrow/kicker matches. Can still
   be overridden per-instance via the `textClass` prop (single font-size class
   only — avoids a dual size conflict). */
interface Props {
  textClass?: string;
}

const { textClass = 'text-xl' } = Astro.props;
---

<p class:list={[textClass, 'uppercase tracking-wide text-text-muted']}>
  <slot />
</p>
