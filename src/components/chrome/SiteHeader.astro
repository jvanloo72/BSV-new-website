---
interface Props {
  currentPath?: string;
}

const { currentPath } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/practice-areas', label: 'Practice Areas' },
  { href: '/attorneys', label: 'Attorneys' },
  { href: '/blog', label: 'Insights' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-[color:var(--color-border)] bg-[color:var(--color-bg)]">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-[color:var(--color-text)]">
      Belcher, Smolen &amp; Van Loo LLP
    </a>
    <ul class="hidden gap-6 text-sm md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'hover:text-[color:var(--color-text)]',
                currentPath === link.href
                  ? 'text-[color:var(--color-text)] font-medium'
                  : 'text-[color:var(--color-text-muted)]',
              ]}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
