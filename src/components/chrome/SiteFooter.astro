---
/* SiteFooter -- refined chrome (D-14 / D-28). Adds the derived wordmark mark +
   typographic firm name on the elevated footer surface; token syntax retrofitted
   from the Phase 1 arbitrary-value form to the Tailwind v4 namespace utilities
   (border-border, bg-bg-elevated, text-text-muted).
   CRITICAL (LEGAL-01, do NOT regress): the site-wide <Disclaimer id="footer" />
   MUST keep rendering on every route -- the disclaimer-crawl test asserts the
   footer disclaimer fragment on every sitemap page. The import, the render, the
   SITE.email mailto, the copyright, and the `mx-auto max-w-6xl px-6`
   locked content-width container are all preserved.
   D-37: the footer shows the firm's full mailing address (footerAddress, derived
   from SITE.location) on every page — NOT "Based in San Francisco."
   2026-05-28: the footer now carries a small "About · Attorney Advertising"
   nav row. The "Attorney Advertising" link points to /attorney-advertising,
   which holds the canonical Cal. Rules of Prof'l Conduct disclosure (Kirkland
   pattern — link site-wide, notation on one page). LEGAL-05 satisfied. */
import { Icon } from 'astro-icon/components';
import Disclaimer from '../legal/Disclaimer.astro';
import { SITE, footerAddress } from '../../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-bg-elevated">
  <div class="mx-auto max-w-6xl px-6 py-10 space-y-6 text-sm text-text-muted">
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 rounded-xs text-text
             focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
             focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
      aria-label="Belcher, Smolen & Van Loo LLP — home"
    >
      <Icon name="mark" class="size-7 shrink-0 text-accent" aria-hidden="true" />
      <span class="text-base font-extrabold tracking-tight">
        Belcher, Smolen &amp; Van Loo
        <span class="font-bold tracking-normal text-text-muted">LLP</span>
      </span>
    </a>

    <Disclaimer id="footer" />

    <address class="not-italic">
      <span class="block">{footerAddress}</span>
    </address>

    <p>
      New client intake:
      <a
        href={`mailto:${SITE.email}`}
        class="relative inline text-accent underline decoration-1 underline-offset-2
               after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-accent
               motion-safe:after:transition-[width] motion-safe:after:duration-200 hover:after:w-full
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
               focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated rounded-xs"
      >{SITE.email}</a>
    </p>

    <small class="block text-xs">
      &copy; {year} {SITE.name}. All rights reserved.
    </small>

    <nav aria-label="Footer" class="text-xs">
      <ul class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <li>
          <a
            href="/about"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >About</a>
        </li>
        <li aria-hidden="true" class="text-text-muted">·</li>
        <li>
          <a
            href="/attorney-advertising"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >Attorney Advertising</a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
