---
/* SiteFooter — centered chrome (2026-05-28 redesign).
   Renders the derived wordmark, the firm's full mailing address (D-37,
   from footerAddress derived from SITE.location), a "Contact Us:" email
   line linking to SITE.email, a centered link row to the four legal /
   firm-info pages, and the copyright at the very bottom.

   2026-05-28 changes from the prior chrome:
   - Removed <Disclaimer id="footer" /> entirely. The general disclaimer
     now lives at /legal-notices (linked from the row below); the
     attorney-advertising notation lives at /attorney-advertising
     (also linked). This is the Kirkland linked-disclosure pattern
     applied across both the general disclaimer AND the AA notation.
   - All content centered (text-center on the inner wrapper).
   - Email label "New client intake:" → "Contact Us:".
   - The link row was expanded from 2 entries (About · Attorney
     Advertising) to 4 entries (About · Attorney Advertising · Privacy
     Policy · Legal Notices).
   - Copyright sits at the very bottom, after the link row.
   - Token-only Tailwind v4 namespace utilities; the
     mx-auto max-w-6xl px-6 content-width container is preserved. */
import { Icon } from 'astro-icon/components';
import { SITE, footerAddress } from '../../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-bg-elevated">
  <div class="mx-auto max-w-6xl px-6 py-10 space-y-6 text-center text-sm text-text-muted">
    <a
      href="/"
      class="group inline-flex items-center gap-2.5 rounded-xs text-text
             focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
             focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
      aria-label="Belcher, Smolen & Van Loo LLP — home"
    >
      <Icon name="mark" class="size-7 shrink-0 text-accent" aria-hidden="true" />
      <span class="text-base font-extrabold tracking-tight">
        Belcher, Smolen &amp; Van Loo
        <span class="font-bold tracking-normal text-text-muted">LLP</span>
      </span>
    </a>

    <address class="not-italic">
      <span class="block">{footerAddress}</span>
    </address>

    <p>
      Contact Us:
      <a
        href={`mailto:${SITE.email}`}
        class="relative inline text-accent underline decoration-1 underline-offset-2
               after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-accent
               motion-safe:after:transition-[width] motion-safe:after:duration-200 hover:after:w-full
               focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
               focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated rounded-xs"
      >{SITE.email}</a>
    </p>

    <nav aria-label="Footer" class="text-xs">
      <ul class="flex flex-wrap items-center justify-center gap-x-2 gap-y-1">
        <li>
          <a
            href="/about"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >About</a>
        </li>
        <li aria-hidden="true" class="text-text-muted">·</li>
        <li>
          <a
            href="/attorney-advertising"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >Attorney Advertising</a>
        </li>
        <li aria-hidden="true" class="text-text-muted">·</li>
        <li>
          <a
            href="/privacy"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >Privacy Policy</a>
        </li>
        <li aria-hidden="true" class="text-text-muted">·</li>
        <li>
          <a
            href="/legal-notices"
            class="rounded-xs text-text-muted underline decoration-1 underline-offset-2
                   motion-safe:hover:text-text motion-safe:hover:decoration-2
                   focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent
                   focus-visible:ring-offset-2 focus-visible:ring-offset-bg-elevated"
          >Legal Notices</a>
        </li>
      </ul>
    </nav>

    <small class="block text-xs">
      &copy; {year} {SITE.name}. All rights reserved.
    </small>
  </div>
</footer>
