---
import { getEntry } from 'astro:content';

// 2026-05-28: 'footer' removed from the union — the site-wide footer
// disclaimer was retired in favor of /legal-notices + /attorney-advertising
// linked from the footer.
type DisclaimerId = 'contact' | 'blog' | 'practice-area' | 'attorney';

interface Props {
  id: DisclaimerId;
}

const { id } = Astro.props;

const entry = await getEntry('disclaimers', id);
if (!entry) {
  throw new Error(
    `Disclaimer entry "${id}" not found in src/content/disclaimers/disclaimers.json. ` +
      `Every DisclaimerId must have a matching entry — add it to the JSON file or remove the reference.`,
  );
}
---

<aside class={`disclaimer disclaimer--${id} text-sm text-[color:var(--color-text-muted)] leading-relaxed`} role="note">
  <p>{entry.data.text}</p>
</aside>
